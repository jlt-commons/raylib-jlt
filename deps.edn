{;; jolt.ffi/write takes the value BEFORE the offset as of jolt 0.8.0, and the
 ;; two spellings are both integers, so an older runtime writes to the wrong
 ;; place rather than failing. Declare the floor so it refuses instead.
 :jolt/min-version "0.8.0"

 ;; The library is its own project in lib/, which is what other projects depend
 ;; on (by :git/sha with :deps/root "lib"). This root file only puts it on the
 ;; classpath for the repo's tooling: clojure-lsp, `bb nrepl` and the like.
 ;;
 ;; The 187 example programs that used to have aliases here moved to
 ;; https://github.com/jlt-commons/raylib-jolt-demo.
 :paths []
 :deps {net.b12n/raylib {:local/root "lib"}}}
