{;; jolt.ffi/write takes the value BEFORE the offset as of jolt 0.8.0, and the
 ;; two spellings are both integers — an older runtime writes to the wrong
 ;; place rather than failing. Declare the floor so it refuses instead.
 :jolt/min-version "0.8.0"

 :paths ["src"]

 ;; raylib is called directly over its C ABI via jolt.ffi (see src/net/b12n/raylib_jlt/core.clj).
 ;; The shared library is the system libraylib 6.0+, install with `brew install raylib`
 ;; on macOS, or your distro's raylib package on Linux. Chez's dlopen default search
 ;; path doesn't include Homebrew's lib dir, so the absolute path is listed first
 ;; (same reason glimmer-gl lists the OpenGL framework path first).
 :jolt/native [{:name "raylib"
                :darwin ["/opt/homebrew/lib/libraylib.dylib" "libraylib.dylib"]
                :linux  ["libraylib.so.6" "libraylib.so"]}]

 :aliases {:test   {:extra-paths ["test"]
                    :main-opts   ["-m" "net.b12n.raylib-jlt.test-runner"]}   ; unit suite: ffi/write argument order
           :check  {:main-opts ["-m" "net.b12n.raylib-jlt.check"]}   ; headless: compile every example
           :run    {:main-opts ["-m" "net.b12n.raylib-jlt.core"]}    ; basic window (default)
           :input  {:main-opts ["-m" "net.b12n.raylib-jlt.input"]}   ; move a circle with arrow keys
           :bounce {:main-opts ["-m" "net.b12n.raylib-jlt.bounce"]}   ; bouncing ball, SPACE pauses
