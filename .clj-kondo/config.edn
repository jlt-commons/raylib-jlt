;; clj-kondo configuration for net.b12n.raylib (lib/).
;;
;; jolt.ffi/defcfn defines a var per bound C symbol. clj-kondo cannot see through
;; the macro, so hooks/jolt_ffi.clj rewrites each call into an equivalent `defn`
;; See that file for why. Without it the library reports ~500 false positives and
;; the linter is unusable as a gate.
{:hooks {:analyze-call {jolt.ffi/defcfn hooks.jolt-ffi/defcfn}}

 ;; jolt.ffi's lexical-allocation macros take a [binding expr] pair and scope the
 ;; binding over the body, which is with-open's shape exactly. Without this the
 ;; bound symbol reads as unresolved.
 :lint-as {jolt.ffi/with-layout    clojure.core/with-open
           jolt.ffi/with-alloc     clojure.core/with-open
           jolt.ffi/with-out       clojure.core/with-open
           jolt.ffi/with-c-string  clojure.core/with-open}}

;; The per-namespace :redundant-nested-call overrides for asteroids,
;; kaleidoscope, splines, flow-field and raymarching left with those examples
;; for jlt-commons/raylib-jolt-demo.
