{:driver  :spawn
 :capture :cgevent-gif

 :examples-cmd "bb demos:examples"

 :out-dir "docs/demos"
 :ledger  "docs/demos/ledger.edn"
 :readme  "docs/demos/README.md"
 :title   "Examples"
 :preamble "Animated GIF previews of every example. Regenerate with `bb record` (requires the internal capture tool; the GIFs here are committed, so you do not need it to browse them)."

 ;; Mirrors the old record_all.clj write-readme! group list, which used
 ;; the bare group name as the heading.
 :groups [{:key "games"
           :title "games"}
          {:key "core"
           :title "core"}
          {:key "shapes"
           :title "shapes"}
          {:key "text"
           :title "text"}
          {:key "3d"
           :title "3d"}
          {:key "generative"
           :title "generative"}
          {:key "textures"
           :title "textures"}
          {:key "shaders"
           :title "shaders"}
          {:key "audio"
           :title "audio"}]

 :defaults {:duration 6
            :fps 10
            :width 480
            :warmup 10}

 :overrides
 {"asteroids"               {:input [[1.0 :key "up"] [1.5 :key "space"] [2.5 :key "left"] [3.5 :key "space"] [4.5 :key "right"]]}
  "tetris"                  {:input [[1.0 :key "left"] [1.5 :key "left"] [2.0 :key "down"] [2.5 :key "up"] [3.5 :key "right"] [4.5 :key "down"]]}
  "pong"                    {:input [[1.0 :key "w"] [2.0 :key "s"] [3.0 :key "w"] [4.0 :key "s"]]}
  "vampire-survivors"       {:input [[1.0 :key "right"] [2.0 :key "down"] [3.0 :key "left"] [4.0 :key "up"]]}
  "snake"                   {:duration 2
                             :input [[0.3 :key "right"] [0.8 :key "down"]]}
  "breakout"                {:input [[1.0 :click 100 400] [2.0 :click 300 400] [3.0 :click 200 400]]}
  "space-invaders"          {:input [[1.0 :key "left"] [1.5 :key "space"] [2.5 :key "right"] [3.0 :key "space"]]}
  "flappy-bird"             {:input [[0.5 :key "space"] [1.5 :key "space"] [2.5 :key "space"] [3.5 :key "space"] [4.5 :key "space"]]}
  "game-2048"               {:input [[1.0 :key "left"] [2.0 :key "up"] [3.0 :key "right"] [4.0 :key "down"]]}
  "minesweeper"             {:input [[1.0 :click 100 100] [2.0 :click 150 150] [3.0 :click 200 100]]}
  "pacman"                  {:input [[1.0 :key "left"] [2.0 :key "up"] [3.0 :key "right"] [4.0 :key "down"]]}
  "doom"                    {:input [[1.0 :key "w"] [2.0 :key "space"] [2.5 :key "right"] [3.5 :key "w"] [4.5 :key "space"]]}
  "helitorus"               {:input [[1.5 :key "right"] [2.5 :key "right"] [3.5 :key "up"] [4.5 :key "left"]]}
  "basic-screen-manager"    {:duration 8
                             :input [[1.5 :key "enter"] [3.5 :key "enter"] [5.5 :key "enter"]]}
  "orthographic-projection" {:duration 8
                             :input [[3.0 :key "space"]]}
  "splines"                 {:duration 8
                             :input [[2.0 :key "space"] [4.0 :key "space"] [6.0 :key "space"]]}

  ;; --- added with the 119-example suite -----------------------------------
  ;; Steering only where an example is driven by input. The rest animate on
  ;; their own and record fine untouched. Keys, never clicks: synthetic clicks
  ;; are pid-routed and raylib ignores them, as input-virtual-controls notes.
  "circle-sector-drawing"   {:duration 8
                             :input [[0.8 :key "w"] [1.2 :key "w"] [1.6 :key "w"] [2.0 :key "w"]
                                     [3.0 :key "f"] [3.4 :key "f"] [3.8 :key "f"] [4.2 :key "f"]
                                     [5.5 :key "r"] [5.9 :key "r"] [6.3 :key "e"] [6.7 :key "e"]]}
  "easings-testbed"         {:duration 10
                             :input [[1.5 :key "right"] [3.5 :key "right"]
                                     [5.5 :key "right"] [7.5 :key "right"]]}
  "random-sequence"         {:duration 8
                             :input [[1.0 :key "space"] [2.5 :key "up"] [2.9 :key "up"] [3.3 :key "up"]
                                     [4.5 :key "space"] [6.0 :key "down"] [6.4 :key "down"]]}
  "undo-redo"               {:duration 10
                             :input [[0.8 :key "right"] [1.2 :key "right"] [1.6 :key "down"]
                                     [2.0 :key "down"] [2.4 :key "left"] [2.8 :key "space"]
                                     [3.4 :key "up"] [3.8 :key "right"]
                                     [5.0 :key "z"] [5.4 :key "z"] [5.8 :key "z"]
                                     [7.0 :key "y"] [7.4 :key "y"]]}
  "camera-2d-platformer"    {:duration 10
                             :input [[0.8 :key "right"] [1.4 :key "space"] [2.0 :key "right"]
                                     [2.6 :key "space"] [3.4 :key "left"]
                                     [4.5 :key "c"] [5.2 :key "right"] [5.8 :key "space"]
                                     [7.0 :key "c"] [7.6 :key "left"] [8.2 :key "space"]]}
  "storage-values"          {:duration 8
                             :input [[1.0 :key "r"] [2.5 :key "enter"] [4.0 :key "r"]
                                     [5.5 :key "space"]]}
  "rlgl-color-wheel"        {:duration 8
                             :input [[1.0 :key "up"] [1.4 :key "up"] [1.8 :key "up"]
                                     [3.0 :key "left"] [3.4 :key "left"]
                                     [4.5 :key "space"] [6.0 :key "space"] [6.5 :key "down"]]}
  ;; ESC raises the confirmation, N dismisses it, ESC raises it again. Never Y,
  ;; which would close the window mid-recording.
  "window-should-close"     {:duration 8
                             :input [[1.5 :key "escape"] [3.5 :key "n"] [5.5 :key "escape"]]}

  ;; --- added with the 91-example suite ------------------------------------
  "texture-procedural"      {:input [[1.5 :key "space"] [3.0 :key "space"] [4.5 :key "space"]]}
  "texture-tiling"          {:duration 8
                             :input [[1.0 :key "up"] [1.4 :key "up"] [1.8 :key "up"] [2.2 :key "up"]
                                     [4.0 :key "down"] [4.4 :key "down"] [4.8 :key "down"]]}
  "bunnymark"               {:input [[1.0 :click 400 300] [2.0 :click 250 200]
                                     [3.0 :click 550 250] [4.0 :click 400 150]]}
  "window-flags"            {:duration 8
                             :input [[1.5 :key "one"] [3.0 :key "two"] [4.5 :key "four"] [6.0 :key "one"]]}
  "clipboard-text"          {:input [[1.5 :key "c"] [3.5 :key "v"]]}
  "input-multitouch"        {:duration 8
                             :input [[0.8 :click 240 200] [1.6 :click 330 250]
                                     [2.4 :click 420 190] [3.2 :click 500 260]
                                     [4.0 :click 560 330] [4.8 :click 460 360]
                                     [5.6 :click 350 330] [6.4 :click 270 270]]}
  ;; Keys, not clicks: synthetic clicks never actuate in a raylib app (input is
  ;; pid-routed and raylib ignores pid-routed BUTTON events). The example drives
  ;; the same state from the arrow keys, which are delivered.
  "input-virtual-controls"  {:duration 8
                             :input [[1.0 :key "right"] [2.0 :key "up"]
                                     [3.0 :key "left"] [4.0 :key "space"]
                                     [5.5 :key "down"] [6.5 :key "space"]]}
  "yaw-pitch-roll"          {:duration 8
                             :input [[1.0 :key "a"] [2.0 :key "w"] [3.0 :key "q"]
                                     [4.5 :key "d"] [5.5 :key "e"]]}
  "first-person-maze"       {:duration 8
                             :input [[0.8 :key "w"] [1.6 :key "w"] [2.4 :key "left"]
                                     [3.2 :key "w"] [4.0 :key "w"] [5.0 :key "right"]
                                     [6.0 :key "w"]]}
  "cellular-automata"       {:duration 8
                             :input [[1.5 :key "up"] [3.0 :key "up"] [4.5 :key "right"]
                                     [6.0 :key "space"]]}
  ;; Both halves render the same shared world through their own camera, so
  ;; neither view shows anything without moving its own player.
  "camera-2d-split-screen"  {:duration 8
                             :input [[2.0 :key "d"] [3.0 :key "d"] [4.0 :key "right"]
                                     [5.0 :key "s"] [6.0 :key "down"] [7.0 :key "right"]]}
  ;; lorenz-attractor, dna-helix, render-texture, window-letterbox,
  ;; monitor-detector and input-gamepad animate or report on their own, so
  ;; they take the defaults with no steering.
  "lorenz-attractor"        {:duration 8}
  "dna-helix"               {:duration 8}

  ;; --- shaders (added with the 97-example suite) ---------------------------
  ;; The two fractal examples take the defaults and need a HUMAN at the mouse
  ;; during the take. Driven by hand they record richly (24 and 30 frames);
  ;; left alone, mandelbrot-set records a correct picture that never moves.
  ;;
  ;; Do NOT reach for a `:key` timeline instead. Synthetic input does not
  ;; actuate a raylib/GLFW window AT ALL - not clicks, and not keys either
  ;; (b12n-cgevent#1 and #6). Measured here, not assumed:
  ;; orthographic-projection has no self-animation and prints its own state,
  ;; and its committed 17-frame take reads "PERSPECTIVE (SPACE to toggle)" in
  ;; BOTH the first and last frame despite a [[3.0 :key "space"]] timeline -
  ;; the frames differ only by window jitter. Every example in this suite that
  ;; records well while carrying a `:key` timeline turns out to self-animate
  ;; (texture-tiling scrolls, input-virtual-controls has a Math/sin hop,
  ;; basic-screen-manager auto-advances every 90 frames), which is why the
  ;; timelines look like they work. game-2048 and minesweeper, which do not
  ;; self-animate, are both single frames.
  }}
