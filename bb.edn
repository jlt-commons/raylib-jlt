  ;; --- native library (libraylib) ------------------------------------------
  lib:check
  {:doc "Is the native libraylib installed for this OS/arch? (read-only)"
   :task (let [{:keys [found checked ldconfig]} (find-raylib)]
           (println (str "OS: " (name (os-kind)) "  ·  arch: " (name (arch-kind))))
           (println "Looked in:")
           (doseq [p checked]
             (println (str "  " (if (lib-present? p) "✓" "·") " " p)))
           (when (seq ldconfig)
             (println "ldconfig cache:")
             (doseq [l ldconfig] (println (str "    " l))))
           (if found
             (let [six? (raylib-6? found)]
               (println (str "\n✓ libraylib found: " found))
               (cond
                 (nil? six?)
                 (println "  version: could not read the symbol table (nm unavailable?) - not gating")

                 six?
                 (println (str "  version: 6.0 or newer (exports " raylib-6-sentinel ")"))

                 :else
                 (do (binding [*out* *err*]
                       (println (str "\n✗ this libraylib predates 6.0 - it does not export "
                                     raylib-6-sentinel "."))
                       (println "  The suite needs 6.0: DrawCircleGradient takes a by-value Vector2")
                       (println "  there and two ints before it, and the symbol name is the same, so")
                       (println "  an older library links fine and draws in the wrong place.")
                       (println (if (= :macos (os-kind))
                                  "  Upgrade with:  brew upgrade raylib"
                                  "  Upgrade with:  bb lib:install  (or build 6.0 from source)")))
                     (System/exit 1))))
             (do
               (binding [*out* *err*]
                 (println "\n✗ libraylib NOT found.")
                 (println "  • install the package:  bb lib:install")
                 (println "  • or point the loader at a source build, e.g.:")
                 (println "      Linux:  export LD_LIBRARY_PATH=$HOME/dev/raylib/build/raylib")
                 (println "      macOS:  export DYLD_LIBRARY_PATH=$HOME/dev/raylib/build/raylib"))
               (System/exit 1))))}

  lib:install
  {:doc "Install libraylib via the platform package manager (add --dry-run to preview)"
   :task (let [{:keys [cmd note manual]} (installer-plan)
               dry? (some #{"--dry-run" "-n"} *command-line-args*)]
           (when note (println note))
           (cond
             manual (do (binding [*out* *err*] (println manual))
                        (System/exit 1))
             dry?   (println "Would run:" (str/join " " cmd))
             :else  (do (println "Running:" (str/join " " cmd))
                        (apply shell cmd)
                        (println "\nDone. Verify with: bb lib:check"))))}

  ;; --- git hooks --------------------------------------------------------------
  ;; FAST hook: lint (any finding blocks, matching `bb lint:strict`) + format +
  ;; clean-ns dry-run, ~2s. FULL adds `bb check` (headless compile of every
  ;; example), the project has no unit-test suite, so that's the closest
  ;; equivalent pre-commit gate.
  hooks:install
  {:doc "Install FAST git pre-commit hook (lint + format + clean-ns, ~2s)"
   :task (let [hook ".git/hooks/pre-commit"]
           (spit hook (str "#!/bin/bash\n"
                           "# net.b12n.raylib-jlt pre-commit (FAST, lint + format + clean-ns dry-run).\n"
                           "# Full (+ headless compile-check): bb hooks:install:full\n"
                           "echo 'pre-commit 0/3: bb check:registration'\n"
                           "bb check:registration || { echo 'pre-commit: registration gaps. See above'; exit 1; }\n"
                           "echo 'pre-commit 1/3: bb lint:strict (clj-kondo)'\n"
                           "bb lint:strict || { echo 'pre-commit: lint findings. See above'; exit 1; }\n"
                           "echo 'pre-commit 2/3: clojure-lsp format --dry'\n"
                           "clojure-lsp format --dry || { echo 'run bb lsp:format'; exit 1; }\n"
                           "echo 'pre-commit 3/3: clojure-lsp clean-ns --dry'\n"
                           "clojure-lsp clean-ns --dry || { echo 'run bb lsp:clean-ns'; exit 1; }\n"
                           "exit 0\n"))
           (shell "chmod" "+x" hook)
           (println "✓ fast pre-commit hook installed")
           (println ">> skip once with: git commit --no-verify"))}

  hooks:install:full
  {:doc "Install FULL git pre-commit hook (+ headless compile-check of every example, slower)"
   :task (let [hook ".git/hooks/pre-commit"]
           (spit hook (str "#!/bin/bash\n"
                           "# net.b12n.raylib-jlt pre-commit (FULL). Fast: bb hooks:install\n"
                           "echo 'pre-commit 1/4: bb lint:strict (clj-kondo)'\n"
                           "bb lint:strict || { echo 'pre-commit: lint findings. See above'; exit 1; }\n"
                           "echo 'pre-commit 2/4: clojure-lsp format --dry'\n"
                           "clojure-lsp format --dry || { echo 'run bb lsp:format'; exit 1; }\n"
                           "echo 'pre-commit 3/4: clojure-lsp clean-ns --dry'\n"
                           "clojure-lsp clean-ns --dry || { echo 'run bb lsp:clean-ns'; exit 1; }\n"
                           "echo 'pre-commit 4/4: bb check (headless compile-check of every example)'\n"
                           "bb check\n"
                           "exit $?\n"))
           (shell "chmod" "+x" hook)
           (println "✓ full pre-commit hook installed")
           (println ">> skip once with: git commit --no-verify"))}

  hooks:uninstall
  {:doc "Remove the git pre-commit hook"
   :task (let [hook ".git/hooks/pre-commit"]
           (if (fs/exists? hook)
             (do (fs/delete hook) (println "✓ pre-commit hook removed"))
             (println ">> no pre-commit hook found")))}

