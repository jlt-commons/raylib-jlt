;; Babashka runner for net.b12n.raylib, the raylib bindings for jolt in lib/.
;;
;; The 187 example programs that used to live here moved to their own repo,
;; https://github.com/jlt-commons/raylib-jolt-demo, one runnable project each.
;;
;;   bb info            grouped cheat-sheet
;;   bb test            unit suite (runs in lib/)
;;   bb check:lib       headless load-check of every library namespace
;;   bb lib:check       is the native libraylib installed for this OS/arch?
;;   bb lib:install     install libraylib via the platform package manager
;;
;; ── Quality: lint/format/checks ──
;;   bb lint                          clj-kondo over lib/src and lib/test (report only)
;;   bb lint:strict                   bb lint, but exit non-zero if any findings
;;   bb lsp:format                    reformat all Clojure files (clojure-lsp)
;;   bb lsp:format-check              check formatting, dry run
;;   bb lsp:clean-ns                  clean + organize ns forms (clojure-lsp)
;;   bb lsp:clean-ns-check            check ns forms, dry run
;;   bb lsp:diagnostics               clojure-lsp diagnostics
;;   bb lsp:check                     all LSP checks (format + clean-ns + diagnostics), dry run
;;   bb lsp:fix                       auto-fix: format + clean-ns (mutating)
;;   bb check:positional-args         find fns with 3+ positional args (report only)
;;   bb check:positional-args:strict  bb check:positional-args, but exit non-zero if any found
;;   bb check:kwarg-calls             find flat :k v calls to a kwargs fn (report only)
;;   bb check:kwarg-calls:strict      bb check:kwarg-calls, but exit non-zero if any found
;;   bb fix:kwarg-calls               rewrite flat :k v call sites into an explicit {} map
;;   bb gen:all                       regenerate lib/src/net/b12n/raylib/all.clj
;;   bb check:aggregator              all.clj matches the generator
;;
;; ── Docs site ──
;;   bb site:build / site:serve / site:clean   (needs a docs-engine checkout)
;;
;; ── Git hooks ──
;;   bb hooks:install                 install FAST pre-commit hook (lint + format + clean-ns, ~2s)
;;   bb hooks:install:full            install FULL pre-commit hook (+ check:lib and test, slower)
;;   bb hooks:uninstall               remove the git pre-commit hook
;;
;; ── Dev ──
;;   bb nrepl [port]                  start a jolt nREPL server (default 7888)
;;
;; Formatting is owned by clojure-lsp, not cljfmt: the two disagree on some
;; compact literal tables, so only one formatter may run against the source,
;; and clojure-lsp was chosen so `lsp:clean-ns` (no cljfmt equivalent) and
;; `lsp:format` share one tool.
;; NOTE: task bodies are read by babashka's EDN reader, which does NOT support
;; #"regex", @deref, or #(...) reader macros. Use (fn [x] ...) etc.
{:min-bb-version "1.3.0"
 :paths ["scripts"]

 :tasks
 {;; --- shared registry + helpers (pure; safe to eval before every task) -----
  :init
  (do
    (require '[babashka.fs :as fs]
             '[clojure.java.shell :as sh]
             '[clojure.string :as str])

    ;; clj-kondo ships a fast native binary; prefer it when installed and fall
    ;; back to the clojure-CLI route so a bare checkout still lints. Both were
    ;; verified against .clj-kondo/hooks/jolt_ffi.clj, which is what teaches
    ;; clj-kondo to see through ffi/defcfn.
    (def kondo-dep
      "{:deps {clj-kondo/clj-kondo {:mvn/version \"2025.02.20\"}}}")

    (defn kondo-argv
      []
      (if (fs/which "clj-kondo")
        ["clj-kondo"]
        ["clojure" "-Sdeps" kondo-dep "-M" "-m" "clj-kondo.main"]))

    ;; jolt's launcher was renamed `joltc` -> `jolt` in 0.5.0, and the current
    ;; installer ships ONLY `jolt`. Machines that have used jolt since before
    ;; the rename often still carry a `joltc` shim, which is why hardcoding
    ;; `joltc` looks fine locally and fails on any fresh install (it did
    ;; exactly that in CI: `Cannot run program "joltc"`). Prefer the modern
    ;; name, fall back to the shim.
    (def jolt-cmd (if (fs/which "jolt") "jolt" "joltc"))

    ;; --- documentation site -------------------------------------------------
    ;; The generator lives in jlt-commons/docs-engine, not here. The site is
    ;; built in CI (.github/workflows/site.yml, which pins an engine tag), so
    ;; these tasks exist only for local preview and are the one place that
    ;; needs a checkout of the engine on disk.
    (def docs-engine-repo "https://github.com/jlt-commons/docs-engine")

    (defn docs-engine-dir
      "Where the engine is checked out: $JLT_DOCS_ENGINE, else a sibling
       directory, else the usual spot. nil when none of them exist."
      []
      (let [home (System/getProperty "user.home")]
        (->> [(System/getenv "JLT_DOCS_ENGINE")
              "../docs-engine"
              (str home "/dev/jlt-commons/docs-engine")]
             (remove nil?)
             (filter (fn [d] (fs/exists? (fs/file d "bb.edn"))))
             first)))

    (defn site-task
      "Runs one of the engine's tasks against this project."
      [task & args]
      (if-let [engine (docs-engine-dir)]
        (let [argv (into ["bb" task (str (fs/cwd))] (remove nil? args))
              res  (apply shell {:dir (str engine) :continue true} argv)]
          (when-not (zero? (:exit res)) (System/exit (:exit res))))
        (do
          (println "The docs engine is not checked out anywhere I looked:")
          (println "  $JLT_DOCS_ENGINE, ../docs-engine, ~/dev/jlt-commons/docs-engine")
          (println)
          (println "  git clone" docs-engine-repo "../docs-engine")
          (println)
          (println "CI does not need this — it checks the engine out itself.")
          (System/exit 1))))
    ;; --- native-library (libraylib) detection + install ----------------------
    ;; jolt loads the shared libraylib over its C ABI (see deps.edn :jolt/native).
    ;; These helpers report where that library lives, or how to install it, for
    ;; Linux, macOS/Intel (/usr/local) and macOS/Apple-Silicon (/opt/homebrew).
    (defn os-kind []
      (let [n (str/lower-case (or (System/getProperty "os.name") ""))]
        (cond (str/includes? n "mac")   :macos
              (str/includes? n "linux") :linux
              :else                     :other)))

    (defn arch-kind []
      (let [a (str/lower-case (or (System/getProperty "os.arch") ""))]
        (cond (or (= a "aarch64") (str/includes? a "arm")) :arm64
              (or (= a "x86_64") (= a "amd64"))            :x86_64
              :else                                        (keyword a))))

    ;; macOS: Homebrew's prefix differs by CPU, /opt/homebrew (Apple Silicon)
    ;; vs /usr/local (Intel). List the arch's likely prefix first.
    (defn mac-lib-candidates []
      (let [prefixes (if (= :x86_64 (arch-kind))
                       ["/usr/local" "/opt/homebrew"]
                       ["/opt/homebrew" "/usr/local"])]
        (mapv (fn [p] (str p "/lib/libraylib.dylib")) prefixes)))

    (defn linux-lib-dirs []
      (distinct
       (concat
        (remove str/blank?
                (str/split (or (System/getenv "LD_LIBRARY_PATH") "")
                           (re-pattern ":")))
        ["/usr/lib" "/usr/lib64" "/usr/local/lib"
         "/usr/lib/x86_64-linux-gnu" "/usr/lib/aarch64-linux-gnu"])))

    ;; libraylib entries known to the Linux dynamic-linker cache ([] elsewhere).
    (defn ldconfig-hits []
      (try
        (let [bin (or (some-> (fs/which "ldconfig") str)
                      (first (filter fs/exists? ["/sbin/ldconfig" "/usr/sbin/ldconfig"])))]
          (if bin
            (->> (or (:out (sh/sh (str bin) "-p")) "")
                 str/split-lines
                 (filter (fn [l] (str/includes? l "raylib")))
                 (mapv str/trim))
            []))
        (catch Exception _ [])))

    ;; Return {:found <path-or-nil> :checked [paths] :ldconfig [lines]}.
    (defn find-raylib []
      (case (os-kind)
        :macos (let [cands (mac-lib-candidates)]
                 {:found    (first (filter fs/exists? cands))
                  :checked  cands
                  :ldconfig []})
        :linux (let [dirs (linux-lib-dirs)
                     hits (mapcat (fn [d]
                                    (when (fs/exists? d)
                                      (map str (fs/glob d "libraylib.so*"))))
                                  dirs)
                     ld   (ldconfig-hits)]
                 {:found    (or (first hits)
                                (some (fn [l]
                                        (let [i (str/index-of l "=> ")]
                                          (when i (str/trim (subs l (+ i 3))))))
                                      ld))
                  :checked  (vec dirs)
                  :ldconfig ld})
        {:found nil :checked [] :ldconfig []}))

    ;; Does this path name a libraylib artifact (file) or hold one (dir)?
    ;; raylib exposes no version at runtime - there is no GetVersion in 5.5 or 6.0,
    ;; confirmed against both headers and both shipped dylibs. So the version is
    ;; read off the exported symbol table instead: DrawLineDashed is one of the 23
    ;; functions 6.0 added and is absent from 5.5. GetKeyName, ComputeSHA256 and
    ;; DrawEllipseV are equally good sentinels if this one ever moves.
    ;;
    ;; This matters because the symbol table is the only honest source. A header on
    ;; the machine can declare functions the installed library does not export, and
    ;; binding one of those compiles cleanly and dies at runtime with a SIGSEGV at
    ;; address 0 rather than a readable missing-symbol error.
    (def raylib-6-sentinel "DrawLineDashed")

    (defn raylib-6? [lib-path]
      (let [nm-args (if (= :macos (os-kind)) ["nm" "-gU"] ["nm" "-D" "--defined-only"])
            {:keys [exit out]} (apply shell {:out :string :err :string :continue true}
                                      (conj (vec nm-args) lib-path))]
        (when (zero? exit)
          ;; Anchored to line end, with an optional leading underscore: macOS nm
          ;; prints _DrawLineDashed and Linux nm prints DrawLineDashed. A \\b word
          ;; boundary does NOT work here - underscore is a word character, so
          ;; \\bDrawLineDashed cannot match the macOS spelling and the check reads
          ;; as "older than 6.0" on a 6.0 library.
          (boolean (re-find (re-pattern (str "(?m)^.*\\s_?" raylib-6-sentinel "$")) (or out ""))))))

    (defn lib-present? [p]
      (cond
        (not (fs/exists? p)) false
        (fs/directory? p)    (boolean (seq (fs/glob p "libraylib.{so,dylib}*")))
        :else                true))

    ;; Platform install command, or :manual instructions when none applies.
    (defn installer-plan []
      (case (os-kind)
        :macos (if (fs/which "brew")
                 {:cmd  ["brew" "install" "raylib"]
                  :note "Homebrew installs into /opt/homebrew (Apple Silicon) or /usr/local (Intel) automatically."}
                 {:manual "Install Homebrew from https://brew.sh, then run: brew install raylib"})
        :linux (cond
                 (fs/which "pacman")  {:cmd ["sudo" "pacman" "-S" "--needed" "raylib"]}
                 (fs/which "apt-get") {:cmd ["sudo" "apt-get" "install" "-y" "libraylib-dev"]}
                 (fs/which "dnf")     {:cmd ["sudo" "dnf" "install" "-y" "raylib" "raylib-devel"]}
                 (fs/which "zypper")  {:cmd ["sudo" "zypper" "install" "-y" "raylib-devel"]}
                 (fs/which "apk")     {:cmd ["sudo" "apk" "add" "raylib" "raylib-dev"]}
                 :else {:manual "No supported package manager found. Build from source: https://github.com/raysan5/raylib/wiki/Working-on-GNU-Linux"})
        {:manual "Unsupported OS. See https://github.com/raysan5/raylib for build instructions."})))

  site:build
  {:doc "Build the documentation site into _site/ (needs a docs-engine checkout)"
   :task (site-task "build")}

  site:serve
  {:doc "Build the docs site and serve it at http://localhost:3000 (bb site:serve [port])"
   :task (site-task "serve" (first *command-line-args*))}

  site:clean
  {:doc "Delete the _site/ build output"
   :task (site-task "clean")}

  info
  {:doc "Grouped cheat-sheet"
   :task (do
           (println "net.b12n.raylib: raylib bindings for jolt, in lib/")
           (println "Examples: https://github.com/jlt-commons/raylib-jolt-demo")
           (println)
           (println "Verify:  `bb test` (unit suite) · `bb check:lib` (load every namespace)")
           (println "         `bb check:aggregator` (all.clj up to date) · regenerate: `bb gen:all`")
           (println "Lint:    `bb lint` (clj-kondo) · Format: `bb lsp:format` · `bb lsp:fix` (format + clean-ns)")
           (println "Native:  `bb lib:check` (is libraylib installed?) · `bb lib:install`")
           (println "Docs:    `bb site:serve` · Git hooks: `bb hooks:install` (fast) · `bb hooks:install:full`")
           (println "Dev:     `bb nrepl [port]` · all tasks: `bb tasks`"))}

  test
  {:doc "Unit suite: ffi/write argument order (runs in lib/)"
   :task (shell {:dir "lib"} jolt-cmd "-M:test")}

  check:lib
  {:doc "Headless load-check of every library namespace in lib/"
   :task (shell {:dir "lib"} jolt-cmd "-M:check")}

  gen:all
  {:doc "Regenerate lib/src/net/b12n/raylib/all.clj from the module namespaces"
   :task (shell "bb" "scripts/gen_aggregator.clj")}

  check:aggregator
  {:doc "all.clj matches what the generator produces, and leaks nothing private"
   :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/gen_aggregator.clj" "--check")]
           (System/exit exit))}

  ;; --- quality: lint (clj-kondo) --------------------------------------------
  ;; Formatting lives under lsp:format below, not here. See the top-of-file
  ;; note on why clojure-lsp (not cljfmt) owns formatting in this project.
  lint
  {:doc "clj-kondo over lib/src and lib/test (report only, always exits 0); strict: bb lint:strict"
   :task (let [{:keys [exit]} (apply shell {:continue true} (concat (kondo-argv) ["--lint" "lib/src" "lib/test"]))]
           (println (if (zero? exit) "✓ clj-kondo: no errors or warnings" "✗ clj-kondo: see findings above")))}

  lint:strict
  {:doc "bb lint, but exit non-zero if clj-kondo reports any findings (2=warnings, 3=errors)"
   :task (let [{:keys [exit]} (apply shell {:continue true} (concat (kondo-argv) ["--lint" "lib/src" "lib/test"]))]
           (System/exit exit))}

  ;; --- quality: clojure-lsp (format + clean-ns + diagnostics) ---------------
  lsp:format
  {:doc "Reformat all Clojure files (clojure-lsp)"
   :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "format")]
           (if (zero? exit)
             (println "✓ formatted")
             (do (println "✗ format failed") (System/exit exit))))}

  lsp:format-check
  {:doc "Check formatting, dry run"
   :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "format" "--dry")]
           (if (zero? exit)
             (println "✓ all files formatted")
             (do (println "✗ files need formatting, run bb lsp:format") (System/exit exit))))}

  lsp:clean-ns
  {:doc "Clean + organize ns forms (clojure-lsp)"
   :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "clean-ns")]
           (if (zero? exit)
             (println "✓ namespaces cleaned")
             (do (println "✗ clean-ns failed") (System/exit exit))))}

  lsp:clean-ns-check
  {:doc "Check ns forms, dry run"
   :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "clean-ns" "--dry")]
           (if (zero? exit)
             (println "✓ all ns forms clean")
             (do (println "✗ ns forms need cleaning, run bb lsp:clean-ns") (System/exit exit))))}

  ;; clojure-lsp's :diagnostics command runs clj-kondo under the hood too, so
  ;; this mostly mirrors `bb lint` plus any LSP-only diagnostics.
  lsp:diagnostics
  {:doc "clojure-lsp diagnostics"
   :task (let [{:keys [exit]} (shell {:continue true} "clojure-lsp" "diagnostics")]
           (if (zero? exit)
             (println "✓ no diagnostics")
             (println "✗ diagnostics found (see above)")))}

  lsp:check
  {:doc "All LSP checks (format + clean-ns + diagnostics), dry run"
   :task (do (println "-> LSP checks (dry run)")
             (println "-> format --dry")
             (shell {:continue true} "clojure-lsp" "format" "--dry")
             (println "-> clean-ns --dry")
             (shell {:continue true} "clojure-lsp" "clean-ns" "--dry")
             (println "-> diagnostics")
             (shell {:continue true} "clojure-lsp" "diagnostics")
             (println "✓ LSP checks done (see above for any issues)"))}

  lsp:fix
  {:doc "Auto-fix: format + clean-ns (mutating)"
   :task (do (println "-> LSP auto-fix")
             (println "-> format")
             (shell {:continue true} "clojure-lsp" "format")
             (println "-> clean-ns")
             (shell {:continue true} "clojure-lsp" "clean-ns")
             (println "✓ auto-fixes applied, run bb lsp:diagnostics + bb check:lib to confirm"))}

  ;; --- quality: positional-args check ---------------------------------------
  check:positional-args
  {:doc "Find fns with 3+ positional args (prefer a kwargs map; report only)"
   :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/check_positional_args.clj")]
           (System/exit exit))}

  check:positional-args:strict
  {:doc "bb check:positional-args, but exit non-zero if any found"
   :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/check_positional_args.clj" "--strict")]
           (System/exit exit))}

  ;; --- quality: kwarg-call-site check ---------------------------------------
  check:kwarg-calls
  {:doc "Find calls passing flat :k v pairs to a kwargs fn (prefer an explicit {} map; report only)"
   :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/kwarg_calls_to_maps.clj")]
           (System/exit exit))}

  check:kwarg-calls:strict
  {:doc "bb check:kwarg-calls, but exit non-zero if any found"
   :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/kwarg_calls_to_maps.clj" "--strict")]
           (System/exit exit))}

  fix:kwarg-calls
  {:doc "Rewrite flat :k v call sites into an explicit {} map (mutating)"
   :task (let [{:keys [exit]} (shell {:continue true} "bb" "scripts/kwarg_calls_to_maps.clj" "--fix")]
           (System/exit exit))}

  ;; --- native library (libraylib) ------------------------------------------
  lib:check
  {:doc "Is the native libraylib installed for this OS/arch? (read-only)"
   :task (let [{:keys [found checked ldconfig]} (find-raylib)]
           (println (str "OS: " (name (os-kind)) "  ·  arch: " (name (arch-kind))))
           (println "Looked in:")
           (doseq [p checked]
             (println (str "  " (if (lib-present? p) "✓" "·") " " p)))
           (when (seq ldconfig)
             (println "ldconfig cache:")
             (doseq [l ldconfig] (println (str "    " l))))
           (if found
             (let [six? (raylib-6? found)]
               (println (str "\n✓ libraylib found: " found))
               (cond
                 (nil? six?)
                 (println "  version: could not read the symbol table (nm unavailable?) - not gating")

                 six?
                 (println (str "  version: 6.0 or newer (exports " raylib-6-sentinel ")"))

                 :else
                 (do (binding [*out* *err*]
                       (println (str "\n✗ this libraylib predates 6.0 - it does not export "
                                     raylib-6-sentinel "."))
                       (println "  The suite needs 6.0: DrawCircleGradient takes a by-value Vector2")
                       (println "  there and two ints before it, and the symbol name is the same, so")
                       (println "  an older library links fine and draws in the wrong place.")
                       (println (if (= :macos (os-kind))
                                  "  Upgrade with:  brew upgrade raylib"
                                  "  Upgrade with:  bb lib:install  (or build 6.0 from source)")))
                     (System/exit 1))))
             (do
               (binding [*out* *err*]
                 (println "\n✗ libraylib NOT found.")
                 (println "  • install the package:  bb lib:install")
                 (println "  • or point the loader at a source build, e.g.:")
                 (println "      Linux:  export LD_LIBRARY_PATH=$HOME/dev/raylib/build/raylib")
                 (println "      macOS:  export DYLD_LIBRARY_PATH=$HOME/dev/raylib/build/raylib"))
               (System/exit 1))))}

  lib:install
  {:doc "Install libraylib via the platform package manager (add --dry-run to preview)"
   :task (let [{:keys [cmd note manual]} (installer-plan)
               dry? (some #{"--dry-run" "-n"} *command-line-args*)]
           (when note (println note))
           (cond
             manual (do (binding [*out* *err*] (println manual))
                        (System/exit 1))
             dry?   (println "Would run:" (str/join " " cmd))
             :else  (do (println "Running:" (str/join " " cmd))
                        (apply shell cmd)
                        (println "\nDone. Verify with: bb lib:check"))))}

  ;; --- git hooks --------------------------------------------------------------
  ;; FAST hook: lint (any finding blocks, matching `bb lint:strict`) + format +
  ;; clean-ns dry-run, ~2s. FULL adds `bb check:lib` (load every library
  ;; namespace) and `bb test`.
  hooks:install
  {:doc "Install FAST git pre-commit hook (lint + format + clean-ns, ~2s)"
   :task (let [hook ".git/hooks/pre-commit"]
           (spit hook (str "#!/bin/bash\n"
                           "# net.b12n.raylib pre-commit (FAST, lint + format + clean-ns dry-run).\n"
                           "# Full (+ check:lib and test): bb hooks:install:full\n"
                           "echo 'pre-commit 1/3: bb lint:strict (clj-kondo)'\n"
                           "bb lint:strict || { echo 'pre-commit: lint findings. See above'; exit 1; }\n"
                           "echo 'pre-commit 2/3: clojure-lsp format --dry'\n"
                           "clojure-lsp format --dry || { echo 'run bb lsp:format'; exit 1; }\n"
                           "echo 'pre-commit 3/3: clojure-lsp clean-ns --dry'\n"
                           "clojure-lsp clean-ns --dry || { echo 'run bb lsp:clean-ns'; exit 1; }\n"
                           "exit 0\n"))
           (shell "chmod" "+x" hook)
           (println "✓ fast pre-commit hook installed")
           (println ">> skip once with: git commit --no-verify"))}

  hooks:install:full
  {:doc "Install FULL git pre-commit hook (+ check:lib and test, slower)"
   :task (let [hook ".git/hooks/pre-commit"]
           (spit hook (str "#!/bin/bash\n"
                           "# net.b12n.raylib pre-commit (FULL). Fast: bb hooks:install\n"
                           "echo 'pre-commit 1/4: bb lint:strict (clj-kondo)'\n"
                           "bb lint:strict || { echo 'pre-commit: lint findings. See above'; exit 1; }\n"
                           "echo 'pre-commit 2/4: clojure-lsp format --dry'\n"
                           "clojure-lsp format --dry || { echo 'run bb lsp:format'; exit 1; }\n"
                           "echo 'pre-commit 3/4: clojure-lsp clean-ns --dry'\n"
                           "clojure-lsp clean-ns --dry || { echo 'run bb lsp:clean-ns'; exit 1; }\n"
                           "echo 'pre-commit 4/4: bb check:lib + bb test'\n"
                           "bb check:lib && bb test\n"
                           "exit $?\n"))
           (shell "chmod" "+x" hook)
           (println "✓ full pre-commit hook installed")
           (println ">> skip once with: git commit --no-verify"))}

  hooks:uninstall
  {:doc "Remove the git pre-commit hook"
   :task (let [hook ".git/hooks/pre-commit"]
           (if (fs/exists? hook)
             (do (fs/delete hook) (println "✓ pre-commit hook removed"))
             (println ">> no pre-commit hook found")))}

  ;; --- dev & repl ---------------------------------------------------------
  nrepl
  {:doc "Start a jolt nREPL server for interactive dev: bb nrepl [port] (default 7888)"
   :task (shell jolt-cmd "nrepl-server" (or (first *command-line-args*) "7888"))}}}
