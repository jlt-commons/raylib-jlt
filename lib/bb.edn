{:min-bb-version "1.3.0"
 :tasks
 {:requires ([babashka.fs :as fs])

  :init
  (do
    ;; jolt's launcher was renamed `joltc` -> `jolt` in 0.5.0. Installs that
    ;; predate the rename often still carry a `joltc` shim, which is why
    ;; hardcoding `joltc` looks fine locally and fails on a fresh install.
    ;; Prefer the modern name, fall back to the old one.
    (def jolt-cmd (if (fs/which "jolt") "jolt" "joltc")))

  check
  {:doc "Headless load-check of every library namespace (no window)"
   :task (shell jolt-cmd "-M:check")}

  gen:all
  {:doc "Regenerate src/net/b12n/raylib/all.clj from the module namespaces"
   :task (let [gen (fs/file ".." "scripts" "gen_aggregator.clj")]
           (if (fs/exists? gen)
             (shell "bb" (str gen))
             (do
               (println "The generator lives one level up, at ../scripts/gen_aggregator.clj,")
               (println "which this checkout does not have (it is not a standalone lib/ clone).")
               (println "Run `bb gen:all` from the raylib-jlt repo root instead.")
               (System/exit 1))))}

  lint
  {:doc "clj-kondo over the library source"
   :task (shell "clj-kondo" "--lint" "src")}

  test
  {:doc "Unit suite (moves here in P5.T3; no-op until then)"
   :task (if (fs/exists? "test")
           (shell jolt-cmd "-M:test")
           (println "no test/ directory yet; the suite moves here in P5.T3"))}}}
